# 게임 서버 env 예시 — 서버 s1.
# 사용법: 이 파일을 servers/s1.env로 복사한 뒤 값을 채우고
#   docker compose -p opensamguk-s1 -f docker-compose.server.yml --env-file servers/s1.env up -d
# 서버를 추가할 때마다 이 파일을 복제(s2.env, s3.env …)하고 SERVER_ID/포트/볼륨이 충돌하지 않게 한다.
# 실제 비밀값(*_PASSWORD, JWT_LEGACY_SECRET)은 절대 커밋하지 마라. servers/*.env는 .gitignore 대상.
# (JWT_PUBLIC_KEY는 공개키라 비밀은 아니지만, gateway-api와 동일 값이어야 한다.)

# --------------------------------------------------------------------------
# 서버 식별자 — **접두 s를 뺀 순수 id**(예: 1, 2, alpha). compose가 s${SERVER_ID}로 합성한다:
#   컨테이너 s${SERVER_ID}-game-api(=s1-game-api) · 프로젝트 opensamguk-s${SERVER_ID}(=opensamguk-s1) · 볼륨 s${SERVER_ID}-game-pgdata.
# 레지스트리(SERVER_REGISTRY_JSON)의 gameApiUrl/gameEngineUrl 호스트명(s1-game-api 등)과 반드시 일치.
# --------------------------------------------------------------------------
SERVER_ID=1
SERVER_NAME=통일 서버
SERVER_GENERATION=1

OPENSAMGUK_WORLD_ID=1

# --------------------------------------------------------------------------
# 버전 = IMAGE_TAG. **이 서버만의 버전을 고정**한다(다른 서버와 달라도 됨).
# 새 릴리스가 나와도 진행 중 서버에 자동 적용되지 않는다 — 어드민 버전 패널/deployer로 bounce 시에만 갱신.
# ⚠️ `latest`는 가변 태그라 pull 시 점프한다. 진행 중 서버는 불변 버전 태그(vX.Y.Z/SHA)로 고정할 것.
# (deployer가 배포 시 이 행을 자동 치환한다 — 형식: IMAGE_TAG=<태그>)
# --------------------------------------------------------------------------
GHCR_REGISTRY=ghcr.io
GHCR_OWNER=peppone-choi
IMAGE_TAG=latest

# --------------------------------------------------------------------------
# 호스트 포트 — 서버마다 겹치지 않게(s1: 81xx/31xx, s2: 82xx/32xx …).
# 로비 servers.json의 절대 URL이 이 포트로 게임에 진입한다.
# --------------------------------------------------------------------------
GAME_API_PORT=8101
WEB_GAME_PORT=3101

# --------------------------------------------------------------------------
# 게임 월드 PostgreSQL — 이 서버 전용(서버마다 독립 DB/볼륨).
# --------------------------------------------------------------------------
GAME_POSTGRES_DB=sammo
GAME_POSTGRES_USER=sammo
GAME_POSTGRES_PASSWORD=change-me-strong-s1

# --------------------------------------------------------------------------
# JWT — gateway-api(공유)가 발급한 토큰을 이 서버 game-api가 검증만 한다(verify-only).
# 공유 스택 .env의 JWT_PUBLIC_KEY와 **동일** 값이어야 함(공개키 — 비밀 아님).
# JWT_LEGACY_SECRET/JWT_LEGACY_ACCESS_ACCEPT_UNTIL은 공유 .env와 동일 값이며, 비밀값이면 비밀로 취급.
# --------------------------------------------------------------------------
JWT_PUBLIC_KEY=change-me-base64-public-key
JWT_LEGACY_SECRET=
JWT_LEGACY_ACCESS_ACCEPT_UNTIL=

# 공유 .env의 INTERNAL_SERVICE_TOKEN과 동일한 비밀값. game-api가 gateway-api 프로필을 조회할 때만 사용.
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token

# --------------------------------------------------------------------------
# 턴/시나리오 — 보통 그대로. 시드는 빈 world_state에서 1회 멱등.
# --------------------------------------------------------------------------
TURN_PROFILE_NAME=che:scenario_2
SCENARIO_SEED_ENABLED=true
SCENARIO_CODE=scenario_1010

# 내부 DNS — 보통 그대로(공유 게이트웨이는 같은 opensamguk-net에 있음).
GAME_API_URL=http://s1-game-api:8081
GATEWAY_API_URL=http://gateway-api:8080
