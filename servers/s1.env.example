# Fake demo world. Copy to servers/sdemo.env; never commit the real .env.
SERVER_ID=demo
SERVER_NAME=Demo World
SERVER_GENERATION=0
OPENSAMGUK_WORLD_ID=1
GHCR_REGISTRY=ghcr.io
GHCR_OWNER=CHANGE_ME
IMAGE_TAG=CHANGE_ME_APP_GIT_SHA
WEB_GAME_TAG=CHANGE_ME_APP_GIT_SHA
GAME_API_PORT=18101
WEB_GAME_PORT=13101
GAME_POSTGRES_DB=demo_game
GAME_POSTGRES_USER=demo
GAME_POSTGRES_PASSWORD=CHANGE_ME_GAME_DATABASE_PASSWORD
JWT_PUBLIC_KEY=CHANGE_ME_MATCHING_PUBLIC_KEY
JWT_LEGACY_SECRET=
JWT_LEGACY_ACCESS_ACCEPT_UNTIL=
INTERNAL_SERVICE_TOKEN=CHANGE_ME_SHARED_INTERNAL_TOKEN
TURN_PROFILE_NAME=CHANGE_ME_SUPPORTED_PROFILE
SCENARIO_SEED_ENABLED=true
SCENARIO_CODE=CHANGE_ME_SUPPORTED_SCENARIO
# Empty explicitly selects classpath lookup. Keep the read-only mount directory.
SCENARIO_LOOKUP_DIR=
SCENARIO_DIR=/data/scenarios
RESET_TURNTERM=60
RESET_EXTEND=1
RESET_BLOCK_GENERAL_CREATE=1
RESET_NPCMODE=0
RESET_SHOW_IMG_LEVEL=3
GAME_API_URL=http://sdemo-game-api:8081
GATEWAY_API_URL=http://gateway-api:8080
