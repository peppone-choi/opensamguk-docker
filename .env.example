# opensamguk-docker — 공유 스택(docker-compose.shared.yml) 환경변수 예시
# 사용법: 이 파일을 .env로 복사한 뒤 값을 채우고
#   docker compose -p opensamguk-shared -f docker-compose.shared.yml --env-file .env up -d
# 실제 비밀값(JWT_SECRET, *_PASSWORD, DEPLOYER_TOKEN 등)은 절대 커밋하지 마라. .env는 .gitignore 대상.
#
# 멀티서버 구조: 공유 스택(이 파일)은 로그인/로비/어드민/배포만 담당.
# 게임 월드(엔진/게임DB/게임API/게임웹)는 서버마다 servers/<id>.env + docker-compose.server.yml로 별도 기동.

# --------------------------------------------------------------------------
# GHCR 이미지 좌표 — 앱 이미지는 소스 저장소(peppone-choi/opensamguk)의 CI가 GHCR로 푸시한다.
# --------------------------------------------------------------------------
GHCR_REGISTRY=ghcr.io
GHCR_OWNER=peppone-choi
# 공유 스택(gateway-api/board-api/web-gateway)이 고정할 버전. 게임 서버 버전과 별개.
# ⚠️ `latest`는 가변 태그라 pull 시 점프한다. 운영은 불변 버전 태그(vX.Y.Z 또는 git SHA)로 고정 권장.
IMAGE_TAG=latest
# (선택) deployer의 GHCR 가용 태그 조회용 토큰. 패키지가 private면 read:packages 스코프 PAT 필요.
# 공개 패키지면 비워둬도 됨(익명 조회). 미설정 시 어드민 버전 패널의 availableTags가 빈 배열일 수 있음.
GHCR_TOKEN=

# --------------------------------------------------------------------------
# 게이트웨이 PostgreSQL — 유저/인증 전용 DB(게임 월드 DB와 분리).
# --------------------------------------------------------------------------
GATEWAY_POSTGRES_DB=sammo_gateway
GATEWAY_POSTGRES_USER=sammo
# 강한 비밀번호로 교체할 것 (compose가 :?required로 강제).
GATEWAY_POSTGRES_PASSWORD=change-me-strong

# --------------------------------------------------------------------------
# JWT — gateway-api가 발급, board-api와 각 서버 game-api가 검증. 모든 서비스가 동일 시크릿이어야 함.
# base64 32B+ 권장.
# --------------------------------------------------------------------------
JWT_SECRET=change-me-base64-secret
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# --------------------------------------------------------------------------
# 관리자 시드 (gateway-api AdminSeeder, 빈 users 테이블에서 1회 멱등 생성)
# --------------------------------------------------------------------------
ADMIN_USERNAME=peppone
ADMIN_PASSWORD=change-me-admin

# --------------------------------------------------------------------------
# 멀티서버 초기 seed + 배포 사이드카
# --------------------------------------------------------------------------
# gateway-api의 game_server가 비어 있는 최초 부팅에만 사용하는 seed이자 deployer desired-state snapshot.
# 최초 DB 전환 뒤 로비/어드민의 정본은 game_server이며, 운영 중 서버 추가/삭제는 어드민→deployer 경로를 쓴다.
# gameApiUrl/gameEngineUrl 호스트명은 docker-compose.server.yml의 container_name(s<id>-game-api 등)과 일치해야 함.
# deployProject는 그 서버 compose 프로젝트명(opensamguk-s<id>) — deployer 호출 시 사용.
# 예시(한 줄로):
# SERVER_REGISTRY_JSON=[{"id":"1","name":"통일 서버","generation":1,"gameApiUrl":"http://s1-game-api:8081","gameEngineUrl":"http://s1-game-engine:8082","deployProject":"opensamguk-s1"}]
SERVER_REGISTRY_JSON=[]

# deployer 사이드카 — gateway-api가 토큰으로 호출(내부망). 강한 랜덤 토큰으로 교체.
DEPLOYER_URL=http://deployer:9000
DEPLOYER_TOKEN=change-me-deployer-token
COMPOSE_HOST_DIR=

# --------------------------------------------------------------------------
# nginx 호스트 포트 / 게이트웨이 내부 DNS
# --------------------------------------------------------------------------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# 내부 서비스 DNS (compose 네트워크) — 보통 그대로 둔다.
GATEWAY_API_URL=http://gateway-api:8080
BOARD_API_URL=http://board-api:8083

# BUILD-time public 오리진 — HTTPS 배포 시 실제 도메인으로 교체(이미지 빌드타임 인라인).
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3000
# 이미지 자산 CDN (opensamguk-images jsDelivr 미러).
NEXT_PUBLIC_IMAGE_CDN=https://cdn.jsdelivr.net/gh/peppone-choi/opensamguk-images

# 세션 쿠키 Secure 플래그 — HTTPS 배포에서만 true. 로컬/HTTP는 false 필수.
COOKIE_SECURE=false
