# Fake examples only. Replace every CHANGE_ME before use. Never commit .env.
GHCR_REGISTRY=ghcr.io
GHCR_OWNER=CHANGE_ME
IMAGE_TAG=CHANGE_ME_APP_GIT_SHA
GHCR_TOKEN=
GATEWAY_POSTGRES_DB=demo_gateway
GATEWAY_POSTGRES_USER=demo
GATEWAY_POSTGRES_PASSWORD=CHANGE_ME_GATEWAY_DATABASE_PASSWORD
JWT_PRIVATE_KEY=CHANGE_ME_PKCS8_PRIVATE_KEY
JWT_PUBLIC_KEY=CHANGE_ME_MATCHING_PUBLIC_KEY
JWT_SIGNING_MODE=RS256
JWT_INCLUDE_PROFILE_CLAIMS=true
JWT_LEGACY_SECRET=
JWT_LEGACY_ACCESS_ACCEPT_UNTIL=
JWT_LEGACY_REFRESH_ACCEPT_UNTIL=
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
INTERNAL_SERVICE_TOKEN=CHANGE_ME_SHARED_INTERNAL_TOKEN
ADMIN_USERNAME=demo_admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
# Fresh shared DB only. See installation guide before seeding an existing DB.
SERVER_REGISTRY_JSON=[]
DEPLOYER_URL=http://deployer:9000
DEPLOYER_TOKEN=CHANGE_ME_DEPLOYER_TOKEN
# Absolute host path of this checkout, not the path inside Deployer.
COMPOSE_HOST_DIR=/CHANGE_ME/opensamguk-docker
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443
GATEWAY_API_URL=http://gateway-api:8080
BOARD_API_URL=http://board-api:8085
# NEXT_PUBLIC_* values belong to the application image BUILD arguments.
NEXT_PUBLIC_GATEWAY_URL=https://game.example.invalid
NEXT_PUBLIC_IMAGE_CDN=https://assets.example.invalid
COOKIE_SECURE=true
