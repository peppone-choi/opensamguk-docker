# opensamguk-docker — 배포(프로덕션) 환경변수 예시
# 사용법: 이 파일을 .env로 복사한 뒤 값을 채우고 `docker compose up -d`.
# 실제 비밀값(JWT_SECRET, POSTGRES_PASSWORD 등)은 절대 커밋하지 마라. .env는 .gitignore 대상.

# --------------------------------------------------------------------------
# GHCR 이미지 좌표 — 앱 이미지는 소스 저장소(peppone-choi/opensamguk)의 CI가 GHCR로 푸시한다.
# --------------------------------------------------------------------------
GHCR_REGISTRY=ghcr.io
GHCR_OWNER=peppone-choi
IMAGE_TAG=latest

# --------------------------------------------------------------------------
# PostgreSQL
# --------------------------------------------------------------------------
POSTGRES_DB=sammo
POSTGRES_USER=sammo
# 강한 비밀번호로 교체할 것 (compose가 :?required로 강제).
POSTGRES_PASSWORD=change-me-strong
POSTGRES_PORT=5432

# --------------------------------------------------------------------------
# Redis
# --------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --------------------------------------------------------------------------
# JWT — gateway-api가 발급, game-api가 검증(동일 시크릿). base64 32B+ 권장.
# --------------------------------------------------------------------------
JWT_SECRET=change-me-base64-secret

# --------------------------------------------------------------------------
# 관리자 시드 (gateway-api AdminSeeder, 빈 users 테이블에서 1회 멱등 생성)
# --------------------------------------------------------------------------
ADMIN_USERNAME=peppone
ADMIN_PASSWORD=change-me-admin

# --------------------------------------------------------------------------
# 포트 / 오리진
# --------------------------------------------------------------------------
GATEWAY_API_PORT=8080
GAME_API_PORT=8081
GAME_ENGINE_PORT=8082
WEB_GATEWAY_PORT=3000
WEB_GAME_PORT=3001
NGINX_HTTP_PORT=80

# 내부 서비스 DNS (compose 네트워크) — 보통 그대로 둔다.
GATEWAY_API_URL=http://gateway-api:8080
GAME_API_URL=http://game-api:8081

# BUILD-time public 오리진 — HTTPS 배포 시 실제 도메인으로 교체.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3000
NEXT_PUBLIC_GAME_URL=http://localhost:3001
# 이미지 자산 CDN (opensamguk-images jsDelivr 미러).
NEXT_PUBLIC_IMAGE_CDN=https://cdn.jsdelivr.net/gh/peppone-choi/opensamguk-images

# 세션 쿠키 Secure 플래그 — HTTPS 배포에서만 true. 로컬/HTTP는 false 필수.
COOKIE_SECURE=false
