# 실제 환경변수/비밀값 — 절대 커밋 금지
.env
.env.*
!.env.example

# 서버별 env(실제 비밀값) — *.example만 커밋
servers/*.env
!servers/*.env.example
servers/.deployer-maintenance
servers/.deployer-lifecycle-journal

# 런타임 TLS 인증서 — 운영 호스트에서만 생성·갱신, 절대 커밋 금지
infra/nginx/certs/

# OS / 에디터
.DS_Store
*.swp

# compose bind-mount 런타임 생성물 — docker-compose.server.yml의
# ${SCENARIO_HOST_DIR:-./data/scenarios} 기본값을 Docker가 자동 생성한다.
# 내용물(RTK14 생성 시나리오)은 앱 레포에서도 gitignore 대상이며,
# untracked로 남으면 deploy.yml의 sync 가드가 이후 모든 배포를 차단한다.
/data/
